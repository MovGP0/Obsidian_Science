{
  "name": "manim-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "An Obsidian plugin prototype for manim-web animations.",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --external:obsidian --format=cjs --platform=browser --target=es2022 --outfile=main.js --minify",
    "dev": "esbuild src/main.ts --bundle --external:obsidian --format=cjs --platform=browser --target=es2022 --outfile=main.js --sourcemap --watch"
  },
  "dependencies": {
    "manim-web": "0.3.24"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.2"
  }
}

